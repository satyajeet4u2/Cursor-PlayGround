# Default environment file for local development
# Use .env.development, .env.staging, or .env.production for explicit environments.
MONGODB_URI=mongodb://127.0.0.1:27017/ops_cases

# JWT signing secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# Server
PORT=4000
NODE_ENV=development

# Optional: comma-separated origins for CORS
# CORS_ORIGINS=https://your-app.vercel.app
