{
  "name": "@ops-cases/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "dev:development": "cross-env DOTENV_CONFIG_PATH=.env.development tsx watch src/index.ts",
    "dev:staging": "cross-env DOTENV_CONFIG_PATH=.env.staging tsx watch src/index.ts",
    "dev:production": "cross-env DOTENV_CONFIG_PATH=.env.production tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production DOTENV_CONFIG_PATH=.env.production node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ops-cases/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.2.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
